<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows builds target net10.0-windows so phone import can use Windows Portable Devices
      (MediaDevices). Other platforms build for plain net10.0. Each CI runner and release
      package builds on its own OS, so `dotnet run` and `dotnet test` need no extra options.
    -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Executable is named PhotoSift(.exe); code keeps the PhotoSift.Desktop namespace. -->
    <AssemblyName>PhotoSift</AssemblyName>
    <RootNamespace>PhotoSift.Desktop</RootNamespace>
    <!-- Local and CI builds show "0.0.0-dev"; the release workflow overrides this from the git tag. -->
    <Version>0.0.0-dev</Version>
    <!-- Local Google OAuth client for development; see docs/google-oauth-setup.md. -->
    <UserSecretsId>photosift-desktop</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
    <PackageReference Include="MediaDevices" Version="2.0.0" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>

  <!--
    Release builds get the Google OAuth client from the GoogleDriveClientId and GoogleDriveClientSecret
    properties (set from GitHub secrets by the release workflow). Without them, the build has no
    built-in client. These values are public in a desktop app, but they are kept out of the repository.
  -->
  <ItemGroup Condition="'$(GoogleDriveClientId)' != ''">
    <AssemblyMetadata Include="GoogleDriveClientId" Value="$(GoogleDriveClientId)" />
    <AssemblyMetadata Include="GoogleDriveClientSecret" Value="$(GoogleDriveClientSecret)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoSift.Core\PhotoSift.Core.csproj" />
  </ItemGroup>

</Project>
