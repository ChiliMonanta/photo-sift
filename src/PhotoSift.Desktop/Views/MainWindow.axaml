<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoSift.Desktop.ViewModels"
        xmlns:svc="using:PhotoSift.Desktop.Services"
        xmlns:views="using:PhotoSift.Desktop.Views"
        x:Class="PhotoSift.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PhotoSift"
        Width="1100" Height="760" MinWidth="720" MinHeight="480">

  <Window.Styles>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
  </Window.Styles>

  <Panel>
    <TabControl Margin="8,0,8,8">
      <!-- Import from phone -->
      <TabItem Header="Import from phone" IsVisible="{Binding HasImport}">
        <DockPanel Margin="8" DataContext="{Binding Import}" x:DataType="vm:ImportViewModel">
          <StackPanel DockPanel.Dock="Top" Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Import from" />
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <Button Content="Refresh" Command="{Binding RefreshPhonesCommand}" />
                    <Button Content="Import from folder…" Command="{Binding AddFolderSourceCommand}" />
                  </StackPanel>
                  <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsIdle}" PlaceholderText="Click Refresh to find connected phones" />
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Classes="muted"
                           Text="Android: unlock the phone and choose &quot;File transfer&quot; in the USB notification. iPhone: unlock it, tap &quot;Trust&quot;, and set Settings &gt; Photos &gt; Transfer to Mac or PC to &quot;Keep Originals&quot;." />
                <TextBlock Text="{Binding PhonesUnavailableReason}" TextWrapping="Wrap" Foreground="IndianRed"
                           IsVisible="{Binding PhonesUnavailableReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="heading" Text="Copy to" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Change…" Command="{Binding ChangeDestinationCommand}" Margin="8,0,0,0" />
                  <TextBlock Text="{Binding DestinationFolder}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock TextWrapping="Wrap" Classes="muted"
                           Text="Photos and videos keep the phone's folders, in a folder named after the phone. Files imported before are skipped." />
              </StackPanel>
            </Border>

            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check" Command="{Binding CheckCommand}" />
                <Button Content="Start copy" Command="{Binding StartCommand}" Classes="accent" />
                <Button Content="Cancel" Command="{Binding CheckCancelCommand}" IsVisible="{Binding CheckCommand.IsRunning}" />
                <Button Content="Cancel" Command="{Binding StartCancelCommand}" IsVisible="{Binding StartCommand.IsRunning}" />
              </StackPanel>
              <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                           IsIndeterminate="{Binding IsProgressIndeterminate}" />
              <TextBlock Text="{Binding FilesLeftText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CurrentFileText}" TextWrapping="Wrap" Classes="muted" />
              <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>

          <Expander Header="Problems" HorizontalAlignment="Stretch" Margin="0,12,0,0" IsVisible="{Binding HasProblems}"
                    IsExpanded="True" VerticalAlignment="Top">
            <ListBox ItemsSource="{Binding Problems}" MaxHeight="220" />
          </Expander>
        </DockPanel>
      </TabItem>

      <!-- Find duplicates -->
      <TabItem Header="Find duplicates">
        <DockPanel Margin="8">

          <!-- Google Drive -->
          <Panel DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding HasDrive}">
            <views:DriveBar DataContext="{Binding Drive}" />
          </Panel>

          <!-- Folder selection -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,*" Margin="0,0,0,12">
            <Border Classes="card">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Folders to scan" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Content="Add folders…" Command="{Binding AddFoldersCommand}" />
                  <Button Content="Remove" Command="{Binding RemoveFolderCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                         MinHeight="64" MaxHeight="120">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding Converter={x:Static svc:LocationLabels.Converter}}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
                  <TextBlock Classes="heading" Text="Master folders" />
                  <TextBlock TextWrapping="Wrap" Classes="muted"
                             Text="In groups with a copy in any master folder, all copies outside the master folders are marked for deletion. Groups without a master copy are not changed." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Content="Add master folders…" Command="{Binding AddMasterFoldersCommand}" />
                  <Button Content="Remove" Command="{Binding RemoveMasterFolderCommand}" />
                  <Button Content="Apply again" Command="{Binding ApplyMasterFoldersCommand}" />
                  <Button Content="Clear" Command="{Binding ClearMasterFoldersCommand}" />
                </StackPanel>
                <Panel>
                  <ListBox ItemsSource="{Binding MasterFolders}" SelectedItem="{Binding SelectedMasterFolder}"
                           MinHeight="64" MaxHeight="120">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding Converter={x:Static svc:LocationLabels.Converter}}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="No master folders selected" Classes="muted" Margin="12"
                             IsHitTestVisible="False" IsVisible="{Binding !HasMasterFolders}" />
                </Panel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Scan controls -->
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Scan for duplicates" Command="{Binding ScanCommand}" Classes="accent" />
              <Button Content="Cancel scan" Command="{Binding ScanCancelCommand}" IsVisible="{Binding IsScanning}" />
            </StackPanel>
            <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            <Border Background="#33FFA500" CornerRadius="4" Padding="8" IsVisible="{Binding IsScanIncomplete}">
              <TextBlock Text="{Binding ScanSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>
          </StackPanel>

          <!-- Deletion bar -->
          <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Clear marks" Command="{Binding ClearMarksCommand}" />
                <Button Content="Review and move to trash…" Command="{Binding ReviewDeletionCommand}" Classes="accent" />
              </StackPanel>
              <TextBlock Text="{Binding MarkedSummary}" VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- Issues -->
          <Expander DockPanel.Dock="Bottom" Header="Errors and notes" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                    IsVisible="{Binding HasIssues}">
            <ListBox ItemsSource="{Binding Issues}" MaxHeight="160" />
          </Expander>

          <!-- Duplicate groups (virtualized: thumbnails load only for displayed groups) -->
          <ListBox ItemsSource="{Binding Groups}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                <Grid ColumnDefinitions="Auto,16,*" Margin="0,6">
                  <Border Width="144" Height="144" CornerRadius="4" ClipToBounds="True"
                          Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                    <Panel>
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                      <TextBlock Text="{Binding ThumbnailStatus}" IsVisible="{Binding !HasThumbnail}"
                                 TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="{Binding Header}" Classes="heading" />
                    <ItemsControl ItemsSource="{Binding Files}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileEntryViewModel">
                          <CheckBox IsChecked="{Binding IsMarked}" IsEnabled="{Binding CanMark}">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                <TextBlock Text="(Google Drive · read-only, kept)" IsVisible="{Binding IsReadOnly}"
                                           ToolTip.Tip="{Binding ReadOnlyReason}" Foreground="SteelBlue" />
                                <TextBlock Text="(master folder)" IsVisible="{Binding IsInMasterFolder}" Foreground="SeaGreen" />
                                <TextBlock Text="(moved to trash)" IsVisible="{Binding IsTrashed}" Foreground="IndianRed" />
                                <TextBlock Text="(kept — at least one copy must remain)" IsVisible="{Binding IsLastKeptCopy}" Classes="muted" />
                              </StackPanel>
                              <TextBlock Text="{Binding DirectoryPath}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>


      <!-- Sort photos -->
      <TabItem Header="Sort photos" IsVisible="{Binding HasSort}">
        <DockPanel Margin="8" DataContext="{Binding Sort}" x:DataType="vm:SortViewModel">
          <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Change…" Command="{Binding ChangeLibraryCommand}" />
              </StackPanel>
              <StackPanel Spacing="2" Margin="0,0,12,0">
                <TextBlock Classes="heading" Text="Photo folder" />
                <TextBlock Text="{Binding LibraryFolder, TargetNullValue='No folder chosen'}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Drag photos onto a folder to move them there. Drag a selected photo to move all selected photos." />
              </StackPanel>
            </DockPanel>
          </Border>

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
            <Border Background="#33FFA500" CornerRadius="4" Padding="8" IsVisible="{Binding IsConfirmingDelete}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                  <Button Content="Move to trash" Command="{Binding ConfirmDeleteCommand}" Classes="accent" />
                </StackPanel>
                <TextBlock Text="{Binding DeleteConfirmationText}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            <Expander Header="Problems" HorizontalAlignment="Stretch" IsVisible="{Binding HasProblems}" IsExpanded="True">
              <ListBox ItemsSource="{Binding Problems}" MaxHeight="160" />
            </Expander>
          </StackPanel>

          <Grid ColumnDefinitions="300,12,*">
            <!-- Folders -->
            <Border Classes="card">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Folders" Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                  <TextBox Text="{Binding NewFolderName}" PlaceholderText="Folder name">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding CreateFolderCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="New folder" Command="{Binding CreateFolderCommand}"
                            ToolTip.Tip="Creates a folder with this name in the selected folder." />
                    <Button Content="Rename" Command="{Binding RenameFolderCommand}"
                            ToolTip.Tip="Gives the selected folder this name." />
                    <Button Content="Delete…" Command="{Binding DeleteFolderCommand}"
                            ToolTip.Tip="Moves the selected folder, with everything in it, to the trash." />
                  </StackPanel>
                </StackPanel>
                <TreeView x:Name="SortFolderTree" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                          DragDrop.AllowDrop="True">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:SortFolderViewModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:SortFolderViewModel">
                      <Border CornerRadius="3" Padding="4,1" Margin="-4,0"
                              Background="{Binding IsDropTarget, Converter={x:Static svc:DropTargetBrush.Converter}}">
                        <TextBlock Text="{Binding Label}" />
                      </Border>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
            </Border>

            <!-- Photos in the selected folder (virtualized: previews load only for shown photos) -->
            <Border Grid.Column="2" Classes="card">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Select all" Command="{Binding SelectAllCommand}" />
                    <Button Content="Select none" Command="{Binding SelectNoneCommand}" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="heading" Text="{Binding SelectedFolder.DisplayPath, FallbackValue=''}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding SelectionText}" />
                  </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <TextBlock DockPanel.Dock="Left" Text="Move selected to" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button DockPanel.Dock="Right" Content="Undo last move" Command="{Binding UndoCommand}" Margin="8,0,0,0" />
                  <Button DockPanel.Dock="Right" Content="Move" Command="{Binding MoveCommand}" Classes="accent" Margin="8,0,0,0" />
                  <ComboBox ItemsSource="{Binding AllFolders}" SelectedItem="{Binding MoveTarget}" HorizontalAlignment="Stretch"
                            PlaceholderText="Choose a folder">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SortFolderViewModel">
                        <TextBlock Text="{Binding DisplayPath}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                  <ItemsRepeater x:Name="SortPhotoGrid" ItemsSource="{Binding Photos}">
                    <ItemsRepeater.Layout>
                      <UniformGridLayout MinItemWidth="156" MinItemHeight="176" MinRowSpacing="8" MinColumnSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="vm:SortPhotoViewModel">
                        <ToggleButton IsChecked="{Binding IsSelected}" Padding="4" Width="156" Height="176"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                      ToolTip.Tip="{Binding Path}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Margin="2,4,2,0" />
                            <Panel Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                              <TextBlock Text="{Binding ThumbnailStatus}" IsVisible="{Binding !HasThumbnail}" TextWrapping="Wrap"
                                         TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Margin="6" Classes="muted" />
                            </Panel>
                          </DockPanel>
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Upload to Google Drive -->
      <TabItem Header="Upload to Google Drive" IsVisible="{Binding HasUpload}">
        <DockPanel Margin="8">
          <Panel DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding HasDrive}">
            <views:DriveBar DataContext="{Binding Drive}" />
          </Panel>
          <DockPanel DataContext="{Binding Upload}" x:DataType="vm:UploadViewModel">
            <StackPanel DockPanel.Dock="Top" Spacing="12">
              <Border Background="#33FFA500" CornerRadius="4" Padding="8" IsVisible="{Binding HasConnectionText}">
                <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap" FontWeight="SemiBold" />
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="heading" Text="Upload from" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Change…" Command="{Binding ChangeLocalFolderCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding LocalFolder, TargetNullValue='No folder chosen'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock TextWrapping="Wrap" Classes="muted"
                             Text="Photos and videos in this folder and its subfolders. Tip: import from your phone and remove duplicates first." />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="heading" Text="Upload to" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Choose…" Command="{Binding ChooseDriveFolderCommand}" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding DriveFolderText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </DockPanel>
                  <TextBlock TextWrapping="Wrap" Classes="muted"
                             Text="The files keep their folders, in a folder named after the local folder. Files whose contents are already anywhere in this Google Drive folder are skipped. Nothing in Google Drive is changed or deleted." />
                </StackPanel>
              </Border>

              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Check" Command="{Binding CheckCommand}" />
                  <Button Content="Start upload" Command="{Binding StartCommand}" Classes="accent" />
                  <Button Content="Cancel" Command="{Binding CheckCancelCommand}" IsVisible="{Binding CheckCommand.IsRunning}" />
                  <Button Content="Cancel" Command="{Binding StartCancelCommand}" IsVisible="{Binding StartCommand.IsRunning}" />
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <TextBlock Text="{Binding FilesLeftText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding CurrentFileText}" TextWrapping="Wrap" Classes="muted" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <Expander Header="Problems" HorizontalAlignment="Stretch" Margin="0,12,0,0" IsVisible="{Binding HasProblems}"
                      IsExpanded="True" VerticalAlignment="Top">
              <ListBox ItemsSource="{Binding Problems}" MaxHeight="220" />
            </Expander>
          </DockPanel>
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- Google Drive folder browser -->
    <Border Background="#99000000" IsVisible="{Binding Drive.IsBrowsing, FallbackValue=False}">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="20"
              Width="640" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel DataContext="{Binding Drive.Browser}" x:DataType="vm:DriveBrowserViewModel">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
            <TextBlock Classes="heading" Text="Choose a Google Drive folder" />
            <TextBlock Text="{Binding CurrentPath}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Classes="muted" Text="{Binding HintText}" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" IsCancel="True" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Up" Command="{Binding UpCommand}" />
                <Button Content="Open" Command="{Binding OpenCommand}" />
                <Button Content="Add to folders to scan" Command="{Binding AddToScanCommand}" Classes="accent"
                        IsVisible="{Binding IsAdding}" />
                <Button Content="Add as master folder" Command="{Binding AddAsMasterCommand}" IsVisible="{Binding IsAdding}" />
                <Button Content="{Binding ChooseLabel}" Command="{Binding ChooseFolderCommand}" Classes="accent"
                        IsVisible="{Binding IsChoosing}" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
          <Panel>
            <ListBox x:Name="DriveFolderList" ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild}"
                     Height="320" DoubleTapped="OnDriveFolderDoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DriveFolderNode">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No subfolders" Classes="muted" Margin="12" IsHitTestVisible="False" IsVisible="{Binding IsEmpty}" />
          </Panel>
        </DockPanel>
      </Border>
    </Border>

    <!-- Confirmation and report overlay -->
    <Border Background="#99000000" IsVisible="{Binding IsOverlayVisible}">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="20"
              MaxWidth="900" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Panel>
          <DockPanel IsVisible="{Binding IsConfirmingDeletion}">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
              <TextBlock Classes="heading" Text="Move these files to the trash?" />
              <TextBlock TextWrapping="Wrap"
                         Text="Each file is checked against its scanned hash first. Changed, missing, or unreadable files are skipped and reported. At least one verified copy of every image is always kept." />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Content="Cancel" Command="{Binding CancelDeletionCommand}" IsCancel="True" />
              <Button Content="Move to trash" Command="{Binding ConfirmDeletionCommand}" Classes="accent" />
            </StackPanel>
            <ListBox ItemsSource="{Binding PendingDeletion}" MaxHeight="420">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntryViewModel">
                  <TextBlock Text="{Binding DisplayPath}" TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <DockPanel IsVisible="{Binding IsShowingDeletionReport}">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12">
              <TextBlock Classes="heading" Text="Deletion result" />
              <TextBlock Text="{Binding DeletionReportSummary}" TextWrapping="Wrap" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Close" Command="{Binding CloseDeletionReportCommand}"
                    HorizontalAlignment="Right" Margin="0,12,0,0" />
            <ListBox ItemsSource="{Binding DeletionReportLines}" MaxHeight="420" />
          </DockPanel>
        </Panel>
      </Border>
    </Border>
  </Panel>
</Window>
